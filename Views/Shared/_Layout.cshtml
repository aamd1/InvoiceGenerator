<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Invoice Studio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header no-print"><nav class="site-nav"><a class="brand" asp-controller="Invoices" asp-action="Index">Invoice Studio</a><span class="nav-links"><a class="nav-link" asp-controller="Invoices" asp-action="Index">Invoices</a><a class="nav-link" asp-controller="Settings" asp-action="Edit">Defaults</a></span></nav></header>
    <div class="app-shell"><main role="main">@RenderBody()</main></div>
    <footer class="site-footer no-print">Invoice Studio - Simple invoice management</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
