@model MyInvoiceGenerator.Models.InvoiceSettings
@{ ViewData["Title"] = "Invoice defaults"; }
<div class="page-heading"><div><p class="eyebrow">Configuration</p><h1>Invoice defaults</h1></div><a class="text-link" asp-controller="Invoices" asp-action="Index">Back to invoices</a></div>
@if (TempData["Message"] is string message) { <div class="success">@message</div> }
<form asp-action="Edit" method="post" class="form-layout">
    <div asp-validation-summary="All" class="validation"></div>
    <section class="panel form-section"><h2>Invoice details</h2><div class="form-grid two"><label>Invoice number prefix<input asp-for="InvoiceNumberPrefix" /></label><label>Payment due after (days)<input asp-for="DueDays" type="number" min="0" /></label></div></section>
    <section class="panel form-section"><h2>Default parties</h2><div class="form-grid two"><fieldset><legend>From</legend><label>Company name<input asp-for="CompanyName" /></label><label>Company ID number<input asp-for="CompanyIdNumber" /></label><div class="address-grid"><label>Number<input asp-for="CompanyStreetNumber" /></label><label>Street<input asp-for="CompanyStreet" /></label><label>Street line 2<input asp-for="CompanyStreetLine2" /></label><label>Postal code<input asp-for="CompanyPostalCode" /></label><label>City<input asp-for="CompanyCity" /></label><label>Country<input asp-for="CompanyCountry" /></label></div><label>Email<input asp-for="CompanyEmail" /></label><label>Phone<input asp-for="CompanyPhone" /></label></fieldset><fieldset><legend>Bill to</legend><label>Client name<input asp-for="ClientName" /></label><label>Client ID number<input asp-for="ClientIdNumber" /></label><div class="address-grid"><label>Number<input asp-for="ClientStreetNumber" /></label><label>Street<input asp-for="ClientStreet" /></label><label>Street line 2<input asp-for="ClientStreetLine2" /></label><label>Postal code<input asp-for="ClientPostalCode" /></label><label>City<input asp-for="ClientCity" /></label><label>Country<input asp-for="ClientCountry" /></label></div><label>Email<input asp-for="ClientEmail" /></label><label>Phone<input asp-for="ClientPhone" /></label></fieldset></div></section>
    <section class="panel form-section"><h2>Default line item</h2><div class="form-grid five"><label>Description<input asp-for="ItemDescription" /></label><label>Details<input asp-for="ItemDetails" /></label><label>Qty<input asp-for="ItemQuantity" type="number" min="0.01" step="0.01" /></label><label>Unit price<input asp-for="ItemUnitPrice" type="number" min="0" step="0.01" /></label><label>VAT (%)<input asp-for="ItemVatRate" type="number" min="0" max="100" step="0.01" /></label></div></section>
    <section class="panel form-section"><h2>Tax and payment</h2><div class="form-grid two"><div><label>VAT rate (%)<input asp-for="VatRate" type="number" min="0" max="100" step="0.01" /></label><label>Notes<textarea asp-for="Notes" rows="4"></textarea></label></div><div><label>Bank<input asp-for="BankName" /></label><label>IBAN<input asp-for="Iban" /></label><label>BIC<input asp-for="Bic" /></label><label>Payment terms<textarea asp-for="PaymentTerms" rows="3"></textarea></label></div></div></section>
    <div class="actions"><a class="text-link" asp-controller="Invoices" asp-action="Index">Cancel</a><button class="button" type="submit">Save defaults</button></div>
</form>
