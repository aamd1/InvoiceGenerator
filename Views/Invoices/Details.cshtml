@model MyInvoiceGenerator.Models.Invoice
@{ ViewData["Title"] = Model.InvoiceNumber; Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - @Model.InvoiceNumber</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="invoice-page">
    <div class="invoice-toolbar no-print">
        <a class="text-link" asp-action="Index">Back to invoices</a>
        <button class="button" onclick="window.print()">Print / PDF</button>
    </div>
    <main class="invoice">
        <header class="top-header">
            <div class="invoice-heading">
                <h1>INVOICE</h1>
                <div class="invoice-info">
                    <div><span>Invoice #</span><strong>@Model.InvoiceNumber</strong></div>
                    <div><span>Issue Date</span><strong>@Model.IssueDate.ToString("MMMM d, yyyy")</strong></div>
                    <div><span>Due Date</span><strong>@Model.DueDate.ToString("MMMM d, yyyy")</strong></div>
                </div>
            </div>
        </header>
        <section class="details">
            <div>
                <h3>From</h3>
                <p><strong>@Model.CompanyName</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyIdNumber))
                {
                    <p>ID: @Model.CompanyIdNumber</p>
                }
                <p>@Model.CompanyStreetNumber @Model.CompanyStreet</p>
                <p>@Model.CompanyStreetLine2</p>
                <p>@Model.CompanyPostalCode @Model.CompanyCity</p>
                <p>@Model.CompanyCountry</p>
                <p>@Model.CompanyEmail</p>
                <p>@Model.CompanyPhone</p>
            </div>
            <div class="client">
                <h3>Bill To</h3>
                <p><strong>@Model.ClientName</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.ClientIdNumber))
                {
                    <p>ID: @Model.ClientIdNumber</p>
                }
                <p>@Model.ClientStreetNumber @Model.ClientStreet</p>
                <p>@Model.ClientStreetLine2</p>
                <p>@Model.ClientPostalCode @Model.ClientCity</p>
                <p>@Model.ClientCountry</p>
                <p>@Model.ClientEmail</p>
                <p>@Model.ClientPhone</p>
            </div>
        </section>
        <table>
            <thead><tr><th class="description-column">Description</th><th class="numeric-column">Qty</th><th class="numeric-column">Price</th><th class="numeric-column">VAT</th><th class="numeric-column">Amount</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr><td><div class="item-name">@item.Description</div><div class="item-description">@item.Details</div></td><td class="numeric-column">@item.Quantity.ToString("0.##")</td><td class="numeric-column">€@item.UnitPrice.ToString("N2")</td><td class="numeric-column">@item.VatRate.ToString("0.##")%</td><td class="numeric-column">€@item.Amount.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
        <section class="summary">
            <div class="summary-row"><span>Subtotal</span><span>€@Model.Subtotal.ToString("N2")</span></div>
            <div class="summary-row"><span>VAT (@Model.VatRate.ToString("0.##")%)</span><span>€@Model.VatAmount.ToString("N2")</span></div>
            <div class="summary-row total"><span>Total</span><span>€@Model.Total.ToString("N2")</span></div>
        </section>
        <section class="notes">
            <h3>Notes</h3>
            <p class="pre-line">@Model.Notes</p>
        </section>
        <footer class="footer">
            <div><strong>Payment Information</strong><br />Bank: @Model.BankName<br />IBAN: @Model.Iban<br />BIC: @Model.Bic</div>
            <div><strong>Payment Terms</strong><br /><span class="pre-line">@Model.PaymentTerms</span><br /><br />Thank you for your business.</div>
        </footer>
    </main>
</body>
</html>
