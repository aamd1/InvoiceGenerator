@model IEnumerable<MyInvoiceGenerator.Models.Invoice>
@{ ViewData["Title"] = "Invoices"; }
<div class="page-heading"><div><p class="eyebrow">Workspace</p><h1>Invoices</h1></div><a class="button" asp-action="Create">New invoice</a></div>
<section class="panel">
    @if (!Model.Any()) { <div class="empty-state"><h2>No invoices yet</h2><p>Create your first invoice to see it here.</p><a class="button" asp-action="Create">Create invoice</a></div> }
    else { <div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Client</th><th>Issue date</th><th>Due date</th><th class="number">Status</th><th></th></tr></thead><tbody>@foreach (var invoice in Model) { <tr><td><strong>@invoice.InvoiceNumber</strong></td><td>@invoice.ClientName</td><td>@invoice.IssueDate.ToString("dd MMM yyyy")</td><td>@invoice.DueDate.ToString("dd MMM yyyy")</td><td class="number"><span class="status">Saved</span></td><td class="number"><a asp-action="Details" asp-route-id="@invoice.Id">View</a></td></tr> }</tbody></table></div> }
</section>